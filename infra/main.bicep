// Stage 2 of the deployment (see scripts/deploy.sh): everything except the
// Key Vault and storage account created by bootstrap.bicep.
targetScope = 'resourceGroup'

param location string = resourceGroup().location

@description('Owner tag value (UPN of the responsible person).')
param owner string

param environmentName string = 'hackathon'

@description('Pinned AFFiNE release (tag of ghcr.io/toeverything/affine). Bump to upgrade.')
param affineImageTag string = '0.27.4'

param affineCpu string = '1.0'
param affineMemory string = '2Gi'

param postgresSkuName string = 'Standard_B1ms'
param postgresSkuTier string = 'Burstable'
param postgresStorageGb int = 32
param postgresAdminLogin string = 'affineadmin'

@description('Public IPv4 addresses allowed to reach Postgres directly.')
param operatorIpAddresses array = []

@minValue(30)
param logRetentionDays int = 30

@description('ACS data location for email data at rest.')
param mailDataLocation string = 'Germany'

@description('Optional custom mail domain (e.g. mmkdigital.io). Deferred for now: empty = Azure-managed sender.')
param mailCustomDomain string = ''

@description('Send from the custom domain. Only after it shows Verified in ACS.')
param mailUseCustomDomain bool = false

param mailSenderUsername string = 'affine'

@description('Application (client) ID of the affine-acs-smtp app registration (created by deploy.sh).')
param smtpClientId string

@description('Object ID of the affine-acs-smtp service principal (created by deploy.sh).')
param smtpPrincipalId string

var suffix = uniqueString(resourceGroup().id)
var tags = {
  project: 'hackathon-platform-affine'
  environment: environmentName
  owner: owner
}

// Created by bootstrap.bicep; secrets are generated by deploy.sh.
resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: 'kv-affine-${suffix}'
}

resource storageAccount 'Microsoft.Storage/storageAccounts@2023-05-01' existing = {
  name: 'staffine${suffix}'
}

module logs 'modules/log-analytics.bicep' = {
  name: 'log-analytics'
  params: {
    name: 'log-affine'
    location: location
    tags: tags
    retentionInDays: logRetentionDays
  }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    name: 'psql-affine-${suffix}'
    location: location
    tags: tags
    administratorLogin: postgresAdminLogin
    administratorPassword: keyVault.getSecret('postgres-admin-password')
    skuName: postgresSkuName
    skuTier: postgresSkuTier
    storageSizeGB: postgresStorageGb
    operatorIpAddresses: operatorIpAddresses
  }
}

module communication 'modules/communication.bicep' = {
  name: 'communication'
  params: {
    acsName: 'acs-affine-${suffix}'
    emailServiceName: 'ecs-affine-${suffix}'
    tags: tags
    dataLocation: mailDataLocation
    customDomain: mailCustomDomain
    useCustomDomain: mailUseCustomDomain
    senderUsername: mailSenderUsername
    smtpPrincipalId: smtpPrincipalId
    smtpClientId: smtpClientId
  }
}

module environment 'modules/containerapp-env.bicep' = {
  name: 'containerapp-env'
  params: {
    name: 'cae-affine'
    location: location
    tags: tags
    logAnalyticsWorkspaceName: logs.outputs.name
    storageAccountName: storageAccount.name
    blobShareName: 'affine-storage'
    configShareName: 'affine-config'
  }
}

module app 'modules/containerapp.bicep' = {
  name: 'containerapp'
  params: {
    name: 'ca-affine'
    location: location
    tags: tags
    environmentId: environment.outputs.id
    environmentDefaultDomain: environment.outputs.defaultDomain
    blobStorageName: environment.outputs.blobStorageName
    configStorageName: environment.outputs.configStorageName
    affineImageTag: affineImageTag
    affineCpu: affineCpu
    affineMemory: affineMemory
    postgresFqdn: postgres.outputs.fqdn
    postgresDatabase: postgres.outputs.databaseName
    postgresAdminLogin: postgresAdminLogin
    postgresAdminPassword: keyVault.getSecret('postgres-admin-password')
    smtpUsername: communication.outputs.smtpUsername
    mailSenderAddress: communication.outputs.senderAddress
    smtpPassword: keyVault.getSecret('acs-smtp-client-secret')
  }
}

output appUrl string = app.outputs.url
output containerAppName string = app.outputs.name
output postgresServerName string = postgres.outputs.name
output mailSenderAddress string = communication.outputs.senderAddress
output mailCustomDomainDnsRecords object = communication.outputs.customDomainVerificationRecords
